<Window x:Class="ExamSocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamSocket"
        mc:Ignorable="d"
        Title="Socket 통신을 진행하는 실시간 채팅 프로그램" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 설정 영역 -->
        <GroupBox Grid.Row="0" Header="연결 설정" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 통신 프로토콜 선택 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="프로토콜:" VerticalAlignment="Center" Margin="5"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="TCP" IsChecked="{Binding IsTcpProtocol}" GroupName="Protocol"/>
                    <RadioButton Content="UDP" IsChecked="{Binding IsUdpProtocol}" GroupName="Protocol"/>
                </StackPanel>

                <!-- 자신의 포트 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="내 포트:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MyPort, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 상대방 정보 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="상대방 IP:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemoteIp, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="포트:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 연결 버튼 -->
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" 
                        Content="{Binding ConnectionButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        Width="100" Height="60"/>
            </Grid>
        </GroupBox>

        <!-- 채팅 메시지 영역 -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto" x:Name="MessageScrollViewer">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10" 
                                Background="{Binding BackgroundColor}"
                                CornerRadius="5"
                                HorizontalAlignment="{Binding Alignment}">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayText}" 
                                           TextWrapping="Wrap"
                                           Foreground="{Binding ForegroundColor}"/>
                                <TextBlock Text="{Binding Timestamp}" 
                                           FontSize="10" 
                                           Foreground="Gray"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 메시지 입력 영역 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="40"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     x:Name="MessageInputBox"
                     KeyDown="MessageInputBox_KeyDown"/>

            <Button Grid.Column="1" 
                    Content="전송"
                    Command="{Binding SendMessageCommand}"
                    Width="100" Height="40"/>
        </Grid>
    </Grid>
</Window>
